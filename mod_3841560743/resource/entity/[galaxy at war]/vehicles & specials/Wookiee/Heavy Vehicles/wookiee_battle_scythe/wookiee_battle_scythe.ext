;==== CREW ====

	("crew_inside")
	("crew_driver" door(emit1) door2(emit2) visor(visor1) anm_left(armor) anm_right(armor))
	("crew_human"    place(gunner) door(emit1) door2(emit2) visor(visor3) anm_left(armor) anm_right(armor)))
	("crew_human" place(commander)	door(emit1) door2(emit2) visor(visor1) anm_left(armor) anm_right(armor)))
	("crew_human"    place(gunner2) door(emit1) door2(emit2) visor(visor4) anm_left(armor) anm_right(armor)))
	("crew_human" place(charger)	door(emit1) door2(emit2) visor(visor2) anm_left(armor) anm_right(armor)))
	("crew_human" place(charger2)	door(emit1) door2(emit2) visor(visor5) anm_left(armor) anm_right(armor)))


(define "seat_inside"
	{boarder
		{anm "passenger"
			{forward	{begin	"board_tank"}}
			{reverse 	{end	"board_tank" -1}}
		}
	}
)
(define "passenger_invisible"
	{placer
		{place "%place" {group "%place"} {linkbone "%bone"} {turnoff {sensor} {visible}}}
	}
	{boarder
		{door "%door"}
		{link "%door" "%place" {anm "%animation"} {forward putoff} {reverse puton}}
	}
)
	("seat_inside")
	("passenger_invisible" place(seat1)	bone(seat01)	door(emit3)	animation(passenger))
	("passenger_invisible" place(seat2)	bone(seat02)	door(emit3)	animation(passenger))
	("passenger_invisible" place(seat3)	bone(seat03)	door(emit3)	animation(passenger))
	("passenger_invisible" place(seat4)	bone(seat04)	door(emit4)	animation(passenger))
	("passenger_invisible" place(seat5)	bone(seat05)	door(emit4)	animation(passenger))
	("passenger_invisible" place(seat6)	bone(seat06)	door(emit4)	animation(passenger))
	("passenger_invisible" place(seat7)	bone(seat07)	door(emit5)	animation(passenger))
	("passenger_invisible" place(seat8)	bone(seat08)	door(emit5)	animation(passenger))
	("passenger_invisible" place(seat9)	bone(seat09)	door(emit5)	animation(passenger))
	("passenger_invisible" place(seat10)	bone(seat10)	door(emit3)	animation(passenger))
	("passenger_invisible" place(seat11)	bone(seat11)	door(emit3)	animation(passenger))
	("passenger_invisible" place(seat12)	bone(seat12)	door(emit4)	animation(passenger))
	("passenger_invisible" place(seat13)	bone(seat13)	door(emit4)	animation(passenger))
	("passenger_invisible" place(seat14)	bone(seat14)	door(emit5)	animation(passenger))
	("passenger_invisible" place(seat15)	bone(seat15)	door(emit5)	animation(passenger))
	("passenger_invisible" place(seat16)	bone(seat16)	door(emit5)	animation(passenger))
)
