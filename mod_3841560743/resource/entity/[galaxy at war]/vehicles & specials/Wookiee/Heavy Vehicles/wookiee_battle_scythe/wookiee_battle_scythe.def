{game_entity
	(include "/properties/tank.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3))
	{props "turret_rotator" "heavy" "vision_lev04" "muzzle_wbs_le_b" "muzzle_wbs_le_s" "muzzle_wbs_ri_b" "muzzle_wbs_ri_s" "muzzle_wbs_up"}
	{Extension "wookiee_battle_scythe.mdl"}
	(include "/entity/[galaxy at war]/vehicles & specials/Wookiee/Heavy Vehicles/wookiee_battle_scythe/wookiee_battle_scythe.ext")
	{targetclass "tank_heavy"}
	{targetSelector "tank_heavy"}

	{boarder
		{anm "armor"
			{forward {begin "gaw_wbscythe1"}}
			{reverse {begin "gaw_wbscythe1"-1}}
		}
		{anm "passenger"
			{forward {begin "gaw_wbscythe2"}}
			{reverse {begin "gaw_wbscythe2"-1}}
		}
	}
	{extender "inventory"
		{box
			{item "wbs_120mm ap ammo" 70}
			{item "wbs_120mm he ammo" 70}
			{item "wbs_60mm ap ammo" 260}
			{item "wbs_60mm he ammo" 260}
			{item "wbs_35mm he ammo" 400}
		}
	}
	{Weaponry
		{place "gun"
			{type "main"}
			{weapon "35mm_wbs" filled}
			{foresight "foresight1"}
			{gunner "gunner"}
			{Barrels 2}
			{basic}
		}
		{place "gunright"
			{weapon "120mm_wbs" filled}
			{foresight "foresight2"}
			{charger "gunner2"}
			{gunner "gunner2"}
			("abm_dymamic_stabilised"
				zeroing(4.0)
				dispersion(0.20)
			)
			{basic}
			{ai_in_manual}
		}
		{place "gunleft"
			{weapon "120mm_wbs" filled}
			{foresight "foresight3"}
			{charger "charger2"}
			{gunner "charger2"}
			("abm_dymamic_stabilised"
				zeroing(4.0)
				dispersion(0.20)
			)
			{basic}
			{ai_in_manual}
		}
		{place "mgunleft"
			{weapon "60mm_wbs" filled}
			{foresight "mforesight3"}
			{charger "charger2"}
			{gunner "charger2"}
			("abm_dymamic_stabilised"
				zeroing(4.0)
				dispersion(0.20)
			)
			{basic}
			{ai_in_manual}
		}
		{place "mgunright"
			{weapon "60mm_wbs" filled}
			{foresight "mforesight2"}
			{charger "gunner2"}
			{gunner "gunner2"}
			("abm_dymamic_stabilised"
				zeroing(4.0)
				dispersion(0.20)
			)
			{basic}
			{ai_in_manual}
		}
	}
	{mass 34200}
	{Chassis
		("mobility_tank"
			speed(35) ;----------Max speed when fully accelerated on road, km/h.
			reverse(15) ;---------Max speed in reverse on road, km/h.
			traverse(32) ;-------Track traverse, per second, in degrees.
			weight(5.8) ;--------Weight in Tonnes.
			power(100) ;---------Engine Power, in hp.
			track(10) ;-----------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(250) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(250) ;---------Range in km, off-road.
		)
	}
}
