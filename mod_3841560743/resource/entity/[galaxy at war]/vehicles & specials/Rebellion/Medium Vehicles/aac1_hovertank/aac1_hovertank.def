{game_entity
	(include "/properties/tank.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3))
	{props "turret_rotator" "medium" "vision_lev04" "muzzle_aac1" "muzzle_aac1_fr"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{Extension "aac1_hovertank.mdl"}
	(include "/entity/[galaxy at war]/vehicles & specials/Rebellion/Medium Vehicles/aac1_hovertank/aac1_hovertank.ext")

	{boarder
		{anm "driver"
			{forward {begin "board_pz4_driver"} {end "seat_gunner_stand"} {base "open_driver"}}
			{reverse {end "board_pz4_driver" -1} {base "open_driver" -1}}
		}
		{anm "left"
			{forward {begin "board_pz-6"} {end "pose_mgun_pz6"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "right"
			{forward {begin "board_pz-6"} {end "pose_mgun_pz6"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "armor"
			{forward {begin "board_HighArmor"} {end "pose_seat_armor_1"}}
			{reverse {end "emit_tank_1"}}
		}
	}
	{extender "inventory"
		{box
			{item "aac1_30mm he ammo" 800}
			{item "aac1_10mm he ammo" 1600}
			{item "ammo aac1_rocket" 128}
		}
	}
	{Weaponry
		{place "gun"
			{type "main"}
			{weapon "30mm_aac1" filled}
			{charger "gunner"}
			{gunner "driver"}
			{Barrels 2}
			("abm_dymamic_stabilised"
				zeroing(4.0)
				dispersion(0.20)
			)
			{rotate}
			{basic}
		}
		{place "gunfront"
			{Barrels 2}
			{type "secondary_main"}
			{weapon "10mm_aac1" filled}
			{foresight "foresight2"}
			{charger "gunner"}
			{gunner "gunner"}
			{shooter "shgun"}
			{rotate}
			{basic}
			{ai_in_manual}
		}
		{place "rocket"
			{RestoreIKAfterAim}
			{weapon "aac1_rocket weapon" filled}
			{foresight "foresight3"}
			{shooter "rocket"}
			{gunner "gunner"}
			{charger "gunner"}
			{Barrels 16}
			{basic}
			{ai_in_manual}
		}
	}
	{mass 12200}
	{Chassis
		("mobility_tank"
			speed(65) ;----------Max speed when fully accelerated on road, km/h.
			reverse(25) ;---------Max speed in reverse on road, km/h.
			traverse(32) ;-------Track traverse, per second, in degrees.
			weight(5.8) ;--------Weight in Tonnes.
			power(100) ;---------Engine Power, in hp.
			track(10) ;-----------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(250) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(250) ;---------Range in km, off-road.
		)
	}
}
