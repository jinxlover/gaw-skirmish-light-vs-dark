{game_entity
	(include "/properties/tank.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3))
	{props "turret_rotator" "medium" "vision_lev04" "muzzle_haml_main" "muzzle_haml_front"}
	{targetclass "tank_medium" "atgm"}
	{Extension "haml_tank.mdl"}
	(include "/entity/[galaxy at war]/vehicles & specials/Confederacy/Medium Vehicles/haml_tank/haml_tank.ext")

	{boarder
		{anm "left"
			{forward {begin "board_pz-6"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "right"
			{forward {begin "board_pz-6"}}
			{reverse {end "emit_tank_2_hold"}}
		}
	}
	{extender "inventory"
		{Box
			{item "ammo aml_missile atgm" 36}
			{item "aat_10mm he ammo" 1600}
		}
	}
	{Weaponry
		{place "gun"
			{type "main"}
			{weapon "aml_mislauncher" filled}
			{foresight "foresight1"}
			{ai_in_manual}
			{Barrels 2}
		}
		{place "gun2"
			{Barrels 4}
			{type "secondary_main"}
			{weapon "10mm_aat" filled}
			{foresight "foresight2"}
			{charger "charger"}
			{gunner "charger"}
			{shooter "shootsm"}
			{rotate}
			{basic}
			{ai_in_manual}
		}
	}
	{mass 12200}
	{Chassis
		("mobility_tank"
			speed(55) ;----------Max speed when fully accelerated on road, km/h.
			reverse(25) ;---------Max speed in reverse on road, km/h.
			traverse(32) ;-------Track traverse, per second, in degrees.
			weight(5.8) ;--------Weight in Tonnes.
			power(100) ;---------Engine Power, in hp.
			track(10) ;-----------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(250) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(250) ;---------Range in km, off-road.
		)
	}
}
