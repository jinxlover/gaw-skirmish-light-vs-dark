{game_entity
	(include "/properties/tank.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3))
	{props "aattank_vitality" "turret_rotator" "medium" "vision_lev04" "muzzle_hag_main" "muzzle_hag_side" "muzzle_hag_small"}
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}
	{Extension "hag-m_heavy_artillery.mdl"}
	(include "/entity/[galaxy at war]/vehicles & specials/Confederacy/Medium Vehicles/hag-m_heavy_artillery/hag-m_heavy_artillery.ext")

	{boarder
		{anm "seat"
			{forward {begin "board_HighArmor"} {end "gaw_hag_seat"}}
			{reverse {end "emit_body"}}
		}
		{anm "left"
			{forward {begin "board_pz-6"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "right"
			{forward {begin "board_pz-6"}}
			{reverse {end "emit_tank_2_hold"}}
		}
	}
	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(seat))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(seat))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(seat))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(seat))

	{extender "inventory"
		{box
			{item "hag_150mm he ammo" 40}
			{item "hag_50mm he ammo" 80}
			{item "hag_50mm ap ammo" 80}
			{item "aat_10mm he ammo" 1600}
		}
	}
	{Weaponry
		{place "gun"
			{type "main"}
			{weapon "150mm_hag" filled}
			("abm_dymamic_gun"
				zeroing(8.0)	; // time it takes to aim until the reticle shrinks. Bigger values, more control.
				dispersion(1)   ; // time it takes to distort the reticle when you move the gun (how abrupt it loses zeroing). Bigger values, more control.
			)
			{rotate}
		}
		{place "gunside"
			{type "main"}
			{weapon "50mm_hag" filled}
			{foresight "foresight2"}
			{charger "charger"}
			{gunner "charger"}
			("abm_dymamic_stabilised"
				zeroing(4.0)
				dispersion(0.20)
			)
			{rotate}
			{basic}
			{ai_in_manual}
		}
		{place "smallgun"
			{Barrels 2}
			{type "secondary_main"}
			{weapon "10mm_aat" filled}
			{foresight "foresight3"}
			{charger "charger"}
			{gunner "charger"}
			{rotate}
			{basic}
			{ai_in_manual}
		}
	}
	{mass 12200}
	{Chassis
		("mobility_tank"
			speed(65) ;----------Max speed when fully accelerated on road, km/h.
			reverse(25) ;---------Max speed in reverse on road, km/h.
			traverse(32) ;-------Track traverse, per second, in degrees.
			weight(5.8) ;--------Weight in Tonnes.
			power(100) ;---------Engine Power, in hp.
			track(10) ;-----------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(250) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(250) ;---------Range in km, off-road.
		)
	}
}
