{game_entity
	(include "/properties/tank.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3))
	{props "turret_rotator" "medium" "vision_lev04" "muzzle_tx130sides_g" "muzzle_tx130t_g" "tx130_rocketsfire"}
	{Extension "tx130t.mdl"}
	(include "/entity/[galaxy at war]/vehicles & specials/Empire/Medium Vehicles/- TX-130_series/tx130t_imp/tx130t.ext")
	{targetclass "tank_medium"}
	{targetSelector "tank_medium"}

	{boarder
		{door "emit"}
		{door "emit5"}
		{anm "driver"
			{forward {begin "board_LowTank_left"} {base "open_driver"}}
			{reverse {end "emit_tank_1_hold"} {base "open_driver" -1}}
		}
		{anm "armor"
			{forward {begin "board_lowArmor"} {end "gaw_seattx130"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "armor1"
			{forward {begin "board_lowArmor"} {end "gaw_seattx1302"}}
			{reverse {end "emit_tank_1"}}
		}
		{anm "left"
			{forward {begin "board_pz-6"} {end "pose_mgun_pz6"}}
			{reverse {end "emit_tank_2_hold"}}
		}
		{anm "right"
			{forward {begin "board_pz-6"} {end "pose_mgun_pz6"}}
			{reverse {end "emit_tank_2_hold"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit1)  animation(armor1))
	("seat_human" place(seat2) bone(seat02) door(emit2)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit3)  animation(armor1))
	("seat_human" place(seat4) bone(seat04) door(emit4)  animation(armor))

	{extender "inventory"
		{box
			{item "tx130i_40mm he ammo" 160}
			{item "ammo ie5_blasters" 2000}
			{item "ammo tx130_missile" 60}
		}
	}
	{Weaponry
		{place "gun"
			{Barrels 2}
			{type "main"}
			{weapon "40mm_tx130i" filled}
			{charger "gunner"}
			{gunner "gunner"}
			{rotate}
			{basic}
		}
		{place "mgun"
			{type "aa"}
			{weapon "ie5m_blaster_tank" filled}
			{foresight "foresight3"}
			{gunner "commander"}
			{charger "commander"}
			{LinkAnimation "off"}
			("abm_mgun")
			{basic}
			{ai_in_manual}
		}
		{place "rocket"
			{RestoreIKAfterAim}
			{weapon "tx130_missile weapon" filled}
			{foresight "foresight2"}
			{shooter "rshooter"}
			{gunner "gunner"}
			{charger "gunner"}
			{Barrels 10}
			{rotate}
			{basic}
			{ai_in_manual}
		}
	}
	{mass 10900}
	{Chassis
		("mobility_tank"
			speed(70) ;----------Max speed when fully accelerated on road, km/h.
			reverse(25) ;---------Max speed in reverse on road, km/h.
			traverse(32) ;-------Track traverse, per second, in degrees.
			weight(5.8) ;--------Weight in Tonnes.
			power(100) ;---------Engine Power, in hp.
			track(10) ;-----------Track performance: (0,10], 10=ideal. Sluggish tanks and vehicles with narrow and non-gripping tracks have a lower performance.
			fuel(250) ;----------Fuel capacity in Litres.
			type(fuel) ;---------Fuel type. (diesel OR fuel)
			range(250) ;---------Range in km, off-road.
		)
	}
}
